# MongoDB connection string including the database name
MONGODB_URI=mongodb+srv://user:password@cluster.example.net/sight-isimm
MONGODB_DB=sight-isimm

# Public canonical URL used by metadata, sitemap and robots.txt
NEXT_PUBLIC_SITE_URL=https://sight-isimm.ieee.tn

# Admin access (server-side only)
ADMIN_EMAIL=admin@sight-isimm.org
ADMIN_PASSWORD=replace-with-a-long-unique-password

# At least 32 random bytes; rotate to invalidate all admin sessions
AUTH_SECRET=replace-with-a-long-random-secret
